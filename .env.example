# Situation Monitor Environment Configuration

# Finnhub API Key (optional - free tier: 60 calls/min, live intraday quotes)
# Get your key at: https://finnhub.io/register
VITE_FINNHUB_API_KEY=your_api_key_here

# Marketstack API Key (optional - fallback for indices when Finnhub isn't
# configured; free tier is 100 requests/month, end-of-day only, no intraday)
# Get your key at: https://marketstack.com/
MARKETSTACK_API_KEY=your_api_key_here

# Node Environment
NODE_ENV=production
